# Firebase (Console do Firebase > Configurações do projeto > Seus apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TMDB (https://www.themoviedb.org/settings/api)
# Usada apenas no servidor pelo proxy /api/tmdb (não vai para o navegador)
TMDB_API_KEY=

# Cloudinary (upload de fotos de perfil e capa, preset "seasonscore_unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
