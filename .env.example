# Supabase (Project Settings > API). A chave "publishable" é pública por natureza;
# a segurança dos dados vem das políticas RLS do banco.
VITE_SUPABASE_URL=https://jitudssddqheithrduij.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google (Google Cloud Console > Credenciais > ID do cliente OAuth). É público.
# Opcional: sem ela, o login com Google usa o redirecionamento pelo Supabase.
VITE_GOOGLE_CLIENT_ID=

# TMDB (https://www.themoviedb.org/settings/api)
# Usada apenas no servidor pelo proxy /api/tmdb (não vai para o navegador)
TMDB_API_KEY=
