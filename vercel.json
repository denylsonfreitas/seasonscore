{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/share.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/series/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Embedly|iframely|SkypeUriPreview|vkShare|Quora Link Preview|Google-InspectionTool|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?type=series&id=:id"
    },
    {
      "source": "/u/:username",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Embedly|iframely|SkypeUriPreview|vkShare|Quora Link Preview|Google-InspectionTool|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?type=user&id=:username"
    },
    {
      "source": "/list/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Embedly|iframely|SkypeUriPreview|vkShare|Quora Link Preview|Google-InspectionTool|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?type=list&id=:id"
    },
    {
      "source": "/lists/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Embedly|iframely|SkypeUriPreview|vkShare|Quora Link Preview|Google-InspectionTool|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?type=list&id=:id"
    },
    {
      "source": "/reviews/:id/:season(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|facebookcatalog|WhatsApp|Embedly|iframely|SkypeUriPreview|vkShare|Quora Link Preview|Google-InspectionTool|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api/share?type=review&id=:id&season=:season"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://jitudssddqheithrduij.supabase.co wss://jitudssddqheithrduij.supabase.co https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
